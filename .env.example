# ── StockFlow Environment Configuration ────────────────────────────────────────
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# ── JWT Secrets (REQUIRED in production) ──────────────────────────────────────
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# These MUST be long, random, and unique. Minimum 32 characters each.
JWT_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_64
REFRESH_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_64_different

# ── Server ────────────────────────────────────────────────────────────────────
# Port to listen on (Render sets this automatically)
PORT=3001

# ── CORS / Frontend ────────────────────────────────────────────────────────────
# Set this to your deployed frontend URL (no trailing slash)
# Example: https://stockflow-obza.onrender.com
FRONTEND_URL=http://localhost:5173

# ── Node.js Environment ────────────────────────────────────────────────────────
# Set to "production" in deployed environments
NODE_ENV=development

# ── Database Path (optional, default: ./data/inventory.db) ────────────────────
# DB_PATH=/custom/path/to/inventory.db
